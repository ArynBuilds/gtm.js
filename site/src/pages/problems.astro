---
import Base from '../layouts/Base.astro'
import data from '../data/site.json'
const { report } = data
const most = Math.max(...report.themes.map(t => t.seen), 1)
const day = new Date(data.built).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })
---
<Base title="What people struggle with" description={`The problems people describe most often, from ${report.posts} public posts. Updated ${day}.`}>
  <p class="text-sm text-soft">Updated {day}</p>
  <h1 class="mt-3 text-4xl font-semibold tracking-tight">What people struggle with</h1>
  <p class="mt-5 max-w-xl leading-relaxed text-soft">
    I read public posts from the communities where they talk, and keep the ones where someone describes a real
    problem. So far: {report.posts} posts read, {report.problems} problems found. These are the ones that repeat.
    The wording is a summary. Nobody is named and no post is linked.
  </p>

  <div class="mt-12 space-y-3">
    {report.themes.map(t => (
      <section class="rounded-2xl border border-line bg-surface px-6 py-5">
        <div class="flex items-baseline gap-5">
          <span class="w-8 shrink-0 text-right text-2xl font-semibold tabular-nums">{t.seen}</span>
          <div class="min-w-0 flex-1">
            <h2 class="text-lg font-medium first-letter:uppercase">{t.name}</h2>
            <div class="mt-2 h-1.5 rounded-full bg-gold" style={`width:${Math.max((t.seen / most) * 100, 4)}%`}></div>
            <p class="mt-3 text-sm text-soft">{t.summary}</p>
            <ul class="mt-4 space-y-2 border-l border-line pl-4 text-sm">
              {t.said.map(s => <li>{s}</li>)}
            </ul>
          </div>
        </div>
      </section>
    ))}
  </div>

  <h2 class="mt-16 text-sm font-semibold text-soft">Tools named in these problems</h2>
  <p class="mt-2 max-w-xl text-sm text-quiet">Not a ranking of bad tools. Popular tools get named more because more people use them.</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {report.tools.map(([name, n]) => <span class="rounded-full bg-raised px-3 py-1 text-sm">{name} <span class="tabular-nums text-soft">{n}</span></span>)}
  </div>
</Base>
